# Long random string, e.g. python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=
AI_API_KEY=
# 1 only on a development machine (never in production)
FLASK_DEBUG=0
PORT=5000
# Online payments are not integrated yet; leave empty (see services/payment_service.py)
PAYMENT_GATEWAY=

# ---- Image Agent (all optional; empty = no AI calls, SVG fallback only) ----
# Providers are used ONLY if listed here AND their key is set. Nothing else is ever called.
IMAGE_PROVIDER=
IMAGE_MODEL=
IMAGE_FALLBACK_PROVIDERS=
GEMINI_API_KEY=
OPENAI_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
# optional per-provider model override, e.g. OPENAI_IMAGE_MODEL=
REFERENCE_DIR=uploads/references
AUTO_GENERATE_PRODUCT_IMAGES=false
